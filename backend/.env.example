# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/miiso?sslmode=require

# ─── Blockchain RPC ─────────────────────────────────────────────
QUICKNODE_WSS_URL=wss://base-mainnet.quiknode.pro/YOUR_KEY
ALCHEMY_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
HTTP_RPC_URL=https://mainnet.base.org

# ─── Agent Session Key ──────────────────────────────────────────
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# ─── Venice AI ──────────────────────────────────────────────────
VENICE_API_URL=https://api.venice.ai/api/v1
VENICE_MODEL=e2ee-qwen3-6-35b-a3b-uncensored-p

# ─── 1Shot Relayer ──────────────────────────────────────────────
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/rpc
ONESHOT_WEBHOOK_PUBLIC_KEY=...  # Ed25519 public key from 1Shot dashboard

# ─── MetaMask Smart Accounts ────────────────────────────────────
DELEGATION_MANAGER_ADDRESS=0x...  # From MetaMask deployment docs
APPROVAL_REVOCATION_ENFORCER=0xe264F1f09A19505a1ca1a86D5b01E8bFdb64324A

# ─── Server ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Confidence Thresholds ──────────────────────────────────────
TIER1_THRESHOLD=0.85   # Auto-fire immediately
TIER2_THRESHOLD=0.70   # Staged 60-second delay
TIER2_VETO_SECONDS=60

# ─── Costs ──────────────────────────────────────────────────────
SUCCESS_FEE_RATE=0.015   # 1.5% of exposed balance

# ─── Demo / Testing Mode ────────────────────────────────────────
DEMO_MODE=true # Set to true to watch a local Anvil fork
